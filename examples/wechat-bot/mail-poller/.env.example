# mail-poller 配置模板: cp .env.example .env 后按需修改
# 启用方式: 取消 deploy/tagent-mail-poller.service 中 EnvironmentFile= 行注释
# ⚠️ 密钥不入 git: OAuth token 由 agently-cli 自管理(~/.agently-cli/), 本目录 .env 不放任何密钥

# tagent 注入端点 (默认本机 bot)
TAGENT_TASK_URL=http://127.0.0.1:8089/task
# seen-store 路径 (去重状态, 重启不丢)
MAIL_POLLER_SEEN_DB=data/mail-poller/seen.json
# +watch 子进程 stderr 落盘 (Retry-After 解析用)
MAIL_POLLER_ERRLOG=data/mail-poller/watch-stderr.log
# CLI 绝对路径覆盖 (默认自动探测: which -> ~/.local/lib/node-*/bin)
#AGENTLY_CLI=/home/lighthouse/.local/lib/node-v22.14.0-linux-x64/bin/agently-cli
# 注入内容前缀
MAIL_POLLER_TAG=[email-inbound]
# 正文注入上限字符数 (超出截断)
MAIL_POLLER_MAX_BODY_CHARS=60000
# seen-store 容量上限 (超出按时间淘汰最旧)
MAIL_POLLER_SEEN_CAP=5000
