# tagent WeChat Bot — 环境变量模板
#
# 用法（二选一）：
#   1. 交互式向导（推荐）：./wizard.sh —— 自动检测依赖 + 引导填写 + 验证连通性 + 生成 .env
#   2. 手动：cp .env.example .env && 编辑 .env 填入密钥，再 ./run.sh
#
# ⚠️ 安全：.env 含真实密钥，已被本目录 .gitignore 的白名单模式天然忽略（绝不提交）。
#    本 .env.example 只含空占位与注释，可安全入库。

# ── 主模型 provider（必需）──────────────────────────────────────────────
# zhipu GLM Coding Plan；端点 https://open.bigmodel.cn/api/coding/paas/v4
# 主 agent 与多数子 agent 默认引用（glm-5.3-flash / glm-4.7）。缺失则无法启动。
# 同一把 key 亦复用于:①记忆引擎语义召回的 embedding-3(端点 .../api/paas/v4/embeddings,512维);
#   ②MCP web-search-prime。故启用语义召回 / MCP **无需额外密钥**。
#   key 缺失/无效时语义召回优雅降级为纯关键词(不阻断启动),但主模型缺失则无法启动。
ZAI_API_KEY=

# ── 可选 provider（tagent.yaml 声明但未被当前 agent 引用时可不填）──────────
# deepseek — https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
# moonshot — https://api.moonshot.cn/v1
MOONSHOT_API_KEY=
# 腾讯混元（hy3_thinking_test 专属）— https://api.lkeap.cloud.tencent.com/plan/v3
TENCENT_HY_API_KEY=
# 腾讯 tokenhub — https://tokenhub.tencentmaas.com/v1
TENCENT_API_KEY=

# ── 运行期可选覆盖（留空/注释即用默认）──────────────────────────────────
# HTTPAPI 监听端口（默认 8089；端点 /healthz /task，RL rollout 与异步任务回写用）
#TAGENT_HTTP_PORT=8089
# OTLP gRPC 追踪导出端点（留空 = noop provider，零开销、行为逐字节不变）
#OTEL_EXPORTER_OTLP_ENDPOINT=
# 日志级别 debug/info/warn/error（默认 info）
#LOG_LEVEL=info
# 持久事件循环的 user/session（默认 wechat-user / wechat-session）
#TAGENT_USER_ID=wechat-user
#TAGENT_SESSION_ID=wechat-session

# ── 平台子系统（治理 / 自进化 / 可靠性 / 语义召回）────────────────────────
# 本 example 已在 tagent.yaml 启用四大子系统:治理闸(enforcement=warn)、自进化(refine+发布道)、
# 常驻可靠性(溢出/兜底/退化状态机/冥想锚点)、记忆引擎(512维语义召回)。
# **均无需额外环境变量/密钥**:治理/自进化/可靠性状态持久化到部署目录(data/*),语义召回复用上面的
# ZAI_API_KEY。启用后 agent 在各复杂场景的行为反应见 docs/wiki/platform/agent-behavior-matrix.md。
#
# systemd 裸机部署:本 .env 由 unit 的 EnvironmentFile 读取(见 deploy/tagent-wechat.service);
#   ./wizard.sh 生成的 .env(chmod 600)直接可用。部署指南见 deploy/README.md 或 `./run.sh systemd`。
