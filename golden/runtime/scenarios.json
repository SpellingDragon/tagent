{
  "schema_version": 1,
  "change": "runtime-rebuild",
  "description": "runtime-rebuild 的 10 个金样场景合同（来自 plan §9）。本文件是“期望值合同”，不是运行证据：真实观测由未来任务 09.1 的 scenario runner 产出，再经 check_runtime_evidence --evidence/--test-log 对照。断言是具体可比值（布尔/数字/消息角色序列/身份关系字典），不硬编码随机 ID、时间或 CallID。",
  "evidence_contract": {
    "note": "上游 scenario runner 的正式入口产物应满足下列字段；检查器只做明示校验，不把它当作防伪或加密证明——runner/source_fingerprint/execution 均由 runner 自报，不声称来源已认证。本块字段集与 check_runtime_evidence.py 的强制集自洽（声明少于强制即失败）。",
    "required_fields": ["schema_version", "runner", "execution", "source_fingerprint", "test_log_ref", "records"],
    "record_fields": ["scenario_id", "test_package", "test_name", "event_refs", "observations"],
    "source_fingerprint_fields": ["module_path", "revision", "content_hash"],
    "execution_fields": ["run_id", "command", "platform", "exit_code"],
    "exit_code_semantics": "execution.exit_code 必须是成功整数 0；非 0（含 bool）判失败，不被后续 pass 覆盖。test_log_ref 必须解析到与 --test-log 同一文件（realpath 相等），指向别的日志判失败。",
    "selection_semantics": "每个场景 runner 单次运行该场景用例 = -count=1（固定场景 case，每个 (包,用例) 有且仅有一次 run）；与之分开，叶任务回归日志用 -count=10（用途不同，不混算）。",
    "sequence_semantics": "逐条 record 的 test_package/test_name 必须与合同逐字一致；test-log 允许合法并行（run→pause→cont→pass），但每个 (包,用例) 必须有终止事件、子测试不得 skip/fail、包级唯一 start/pass、无包级 fail。"
  },
  "scopes": {
    "note": "验收集登记（唯一、全 10 场景各归一标签）。check_runtime_evidence.py 默认 --scope complete（严格，全 10 必验）；--scope deterministic 只验确定性标签场景并输出 scope 与 remaining_required（把资源场景列为显式欠账，不报全通过，也不得用合成资源用例凑数）。合同始终含全 10 场景。",
    "labels": ["deterministic", "resource"],
    "label_semantics": {
      "deterministic": "不依赖外部真实资源（真实 SFT 制品/真实模型/MCP/A2A/embedding/微信/collector 等）的合同场景；09.1 确定性 runner 的责任集。",
      "resource": "需外部真实资源与授权的合同场景；本波仅 S10（真实 SFT 批次/消费者 06.6 等），由 09.5 逐项启用门验收，未授权保持 remaining-required。"
    }
  },
